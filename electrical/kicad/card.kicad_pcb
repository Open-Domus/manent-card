				)
			)
		)
		(property "Note" "Hears the phone through its back: the far side of a call. On the microphones' rail, so the switch and the light govern it too. Shares data line 1 with microphone A: SELECT at the rail makes it speak on the rising clock edge (datasheet table 7); that microphone A speaks on the falling one is to confirm. 290 uA at this clock, asleep when the clock is held low. Senses along Z, across the board. It measures how its own body shakes: the board under it must be fixed stiffly to the back skin, with a post or a bead of hard adhesive next to it"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "fd78c56f-42a2-4803-9743-8b1c7f45be69")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
